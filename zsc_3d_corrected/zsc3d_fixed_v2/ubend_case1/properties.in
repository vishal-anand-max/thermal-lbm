787.0 1000.0
# tauRho, tauPhi
1.0 0.7
# IntWidth, sigma, Gamma
5.0 0.001 40.0
# Eo, pConv
10.0 1.0D-6
# sinthita, costhita (gravity in -z: sin=1, cos=0 for vertical U-bend)
1.0 0.0
# geom_mode (2 = U-bend)
2
# u_inlet_max (parabolic peak velocity at inlet)
0.01
# ubend_a, ubend_Rbend, ubend_Larm (channel width, bend radius, arm length)
100 100 200
